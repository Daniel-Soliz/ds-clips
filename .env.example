# Banco/filas (docker compose já usa estes defaults internamente)
DATABASE_URL=postgresql://dsclips:dsclips@postgres:5432/dsclips?schema=public
REDIS_URL=redis://redis:6379

# Opcional: use Anthropic para ranking semântico mais forte. O modo local funciona sem chave.
# Obtenha em: https://console.anthropic.com/settings/keys
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
# Modelo ativo recomendado em 2026-09:
ANTHROPIC_MODEL=claude-sonnet-5

# Whisper local (sem chave de API)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# Limites do MVP
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=120
MAX_CLIPS=8

# Armazenamento local no desenvolvimento
STORAGE_DRIVER=local
DATA_DIR=/data

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
